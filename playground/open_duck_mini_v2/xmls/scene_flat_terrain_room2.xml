    <asset>
        <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
            width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>

        <texture type="2d" name="door_texture" file="assets/WoodTexture.png"/>
        <material name="door_material" texture="door_texture" texuniform="true" texrepeat="1 1" reflectance="0.1"/>
        <mesh name="door" file="door.stl" scale="0.05 0.05 0.05"/>

        <texture name="wall_tex" type="2d" file="assets/wall_texture.png"/>
        <material name="wall_material_x" texture="wall_tex"/>
        <material name="wall_material_y" texture="wall_tex"/>
        <material name="red_material" rgba="1 0 0 1"/>
        <mesh name="wall1_mesh" file="wall1_mesh.obj"/>
        <mesh name="wall2_mesh" file="wall2_mesh.obj"/>
        <mesh name="wall3_mesh" file="wall3_mesh.obj"/>
        <mesh name="wall4_mesh" file="wall4_mesh.obj"/>
    </asset>

    <worldbody>
        <body name="floor">
            <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="0"
                priority="1" friction="0.6" condim="3"/>
        </body>

        <body name="door">
            <geom name="door_geom"
                type="mesh"
                class="visual"
                mesh="door"
                material="door_material"
                pos="1.1 0.47 0"
                group="2"/>
        </body>

        <body name="wall_body" pos="1.4 -1.25 0.5">
            <geom name="wall1" type="mesh" mesh="wall1_mesh" material="wall_material_y" contype="1" conaffinity="1" priority="1" friction="0.6" condim="3"/>
        </body>
        <body name="wall_body2" pos="-1 -1.25 0.5">
            <geom name="wall2" type="mesh" mesh="wall2_mesh" material="wall_material_y" contype="1" conaffinity="1" priority="1" friction="0.6" condim="3"/>
        </body>
        <body name="wall_body3" pos="0.2 -3 0.5">
            <geom name="wall3" type="mesh" mesh="wall3_mesh" material="wall_material_x" contype="1" conaffinity="1" priority="1" friction="0.6" condim="3"/>
        </body>
        <body name="wall_body4" pos="0.2 0.5 0.5">
            <geom name="wall4" type="mesh" mesh="wall4_mesh" material="wall_material_x" contype="1" conaffinity="1" priority="1" friction="0.6" condim="3"/>
        </body>

        

    </worldbody>
