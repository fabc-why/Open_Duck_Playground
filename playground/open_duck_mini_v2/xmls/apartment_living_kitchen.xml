      <geom name="desk_chair_leg2_visual" class="visual" type="cylinder" size="0.015 0.225" pos="-0.17 0.17 0.225" material="mat_chrome"/>
      <geom name="desk_chair_leg3_visual" class="visual" type="cylinder" size="0.015 0.225" pos="0.17 -0.17 0.225" material="mat_chrome"/>
      <geom name="desk_chair_leg4_visual" class="visual" type="cylinder" size="0.015 0.225" pos="0.17 0.17 0.225" material="mat_chrome"/>
