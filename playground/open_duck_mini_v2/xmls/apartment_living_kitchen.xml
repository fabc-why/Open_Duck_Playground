
<mujoco model="apartment_living_kitchen">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" cone="elliptic"/>
  <size memory="100M"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture name="tex_floor" type="2d" builtin="checker" rgb1="0.42 0.28 0.17" rgb2="0.50 0.35 0.22" width="300" height="300" mark="none"/>
    <material name="mat_floor_wood" texture="tex_floor" texrepeat="10 10" texuniform="true" specular="0.2" shininess="0.3" reflectance="0.05"/>
    <material name="mat_wall_paint" rgba="0.93 0.91 0.85 1" specular="0.1" shininess="0.05"/>
    <material name="mat_ceiling" rgba="0.97 0.97 0.95 1" specular="0.05" shininess="0.02"/>
    <material name="mat_cabinet_wood" rgba="0.45 0.28 0.15 1" specular="0.2" shininess="0.15"/>
    <material name="mat_countertop" rgba="0.22 0.22 0.24 1" specular="0.5" shininess="0.35" reflectance="0.1"/>
    <material name="mat_steel" rgba="0.75 0.76 0.78 1" specular="0.8" shininess="0.6" reflectance="0.3"/>
    <material name="mat_dark_appliance" rgba="0.12 0.12 0.13 1" specular="0.5" shininess="0.4"/>
    <material name="mat_fridge" rgba="0.88 0.89 0.90 1" specular="0.6" shininess="0.5" reflectance="0.2"/>
    <material name="mat_sofa_fabric" rgba="0.33 0.38 0.47 1" specular="0.05" shininess="0.02"/>
    <material name="mat_wood_furniture" rgba="0.55 0.38 0.22 1" specular="0.15" shininess="0.1"/>
    <material name="mat_wood_desk" rgba="0.60 0.42 0.25 1" specular="0.15" shininess="0.1"/>
    <material name="mat_glass" rgba="0.75 0.88 0.92 0.35" specular="0.9" shininess="0.9"/>
    <material name="mat_frame_wood" rgba="0.30 0.18 0.10 1" specular="0.1" shininess="0.05"/>
    <material name="mat_chrome" rgba="0.85 0.85 0.88 1" specular="0.9" shininess="0.8" reflectance="0.4"/>
  </asset>

  <default>
    <geom type="box"/>
    <default class="collision">
      <geom group="3" contype="1" conaffinity="1" condim="3" friction="0.9 0.01 0.0001" rgba="1 0 0 0"/>
    </default>
    <default class="visual">
      <geom group="1" contype="0" conaffinity="0" density="0"/>
    </default>
  </default>

  <worldbody>
    <light name="sun" directional="true" pos="0 0 5" dir="0.2 0.2 -1" diffuse="0.35 0.35 0.33" specular="0.1 0.1 0.1"/>
