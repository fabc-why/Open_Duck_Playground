    <light name="ceiling_light_study" pos="1.2 -1.5 2.4" dir="0 0 -1" diffuse="0.5 0.5 0.47" specular="0.1 0.1 0.1"/>

    <!-- FLOOR -->
    <body name="floor" pos="0 0 0">
      <geom name="floor_collision" class="collision" size="2.5 2.5 0.025" pos="0 0 -0.025" friction="1.0 0.005 0.0001" condim="3"/>
      <geom name="floor_visual" class="visual" size="2.5 2.5 0.025" pos="0 0 -0.025" material="mat_floor_wood"/>
    </body>

    <!-- CEILING -->
    <body name="ceiling" pos="0 0 0">
