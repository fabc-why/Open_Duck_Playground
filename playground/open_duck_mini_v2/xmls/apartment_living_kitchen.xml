      <geom name="coffee_table_leg1_visual" class="visual" type="cylinder" size="0.02 0.2" pos="-0.44 -0.24 0.2" material="mat_wood_furniture"/>
      <geom name="coffee_table_leg2_visual" class="visual" type="cylinder" size="0.02 0.2" pos="-0.44 0.24 0.2" material="mat_wood_furniture"/>
      <geom name="coffee_table_leg3_visual" class="visual" type="cylinder" size="0.02 0.2" pos="0.44 -0.24 0.2" material="mat_wood_furniture"/>
      <geom name="coffee_table_leg4_visual" class="visual" type="cylinder" size="0.02 0.2" pos="0.44 0.24 0.2" material="mat_wood_furniture"/>
